rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function ownsPhotoBackup(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && 'backup_photos' in request.auth.token.get('revenueCatEntitlements', []);
    }

    match /users/{uid}/kit-photos/{fileName} {
      allow get: if ownsPhotoBackup(uid);
      allow list: if request.auth != null && request.auth.uid == uid;
      allow create, update: if ownsPhotoBackup(uid)
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
